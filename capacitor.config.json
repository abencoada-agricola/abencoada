{
  "appId": "br.com.abencoada.diesel",
  "appName": "Abençoada",
  "webDir": "mobile-dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#193c2b"
  },
  "plugins": {
    "SystemBars": {
      "style": "LIGHT",
      "hidden": false,
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  },
  "ios": {
    "backgroundColor": "#193c2b",
    "contentInset": "never",
    "preferredContentMode": "mobile"
  }
}
